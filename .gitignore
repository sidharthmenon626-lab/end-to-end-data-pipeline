dbt/target/
dbt/dbt_packages/
dbt/logs/

# Airflow logs & local database
airflow/logs/
airflow/*.db
airflow/*.pid
airflow/*.cfg
airflow/airflow.cfg

# Operating system artifacts
.DS_Store
Thumbs.db

# IDE configuration
.vscode/
.idea/

