# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure local warehouse credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Target Warehouse (PostgreSQL)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_DB=analytics_dw
WAREHOUSE_USER=pipeline_user
WAREHOUSE_PASSWORD=pipeline_secure_pass

# Pipeline Schemas
RAW_SCHEMA=raw
STAGING_SCHEMA=staging
MARTS_SCHEMA=marts

# Data Landing Path
RAW_DATA_DIR=./data/raw

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Remote Source Databases (Neon PostgreSQL Cloud)
ECOM_SOURCE_URL=postgresql://ecom_ro_user:******@ep-bold-hall-azhf2f45-pooler.c-3.ap-southeast-1.aws.neon.tech:5432/neondb
SAAS_SOURCE_URL=postgresql://saas_ro_user:******@ep-bold-hall-azhf2f45-pooler.c-3.ap-southeast-1.aws.neon.tech:5432/neondb
