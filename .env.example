# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure local warehouse credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Target Warehouse (PostgreSQL)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DB=analytics_dw
WAREHOUSE_USER=pipeline_user
WAREHOUSE_PASSWORD=pipeline_secure_pass

# Pipeline Schemas
RAW_SCHEMA=raw
STAGING_SCHEMA=staging
MARTS_SCHEMA=marts

# Data Landing Path
RAW_DATA_DIR=./data/raw

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
